 class Task:
+  def model_context(self, s, xi):
+    """Express known B2 push vectors in the same heading frame as WM features."""
+    if NJ == 12:
+      schedule = xi[..., 18:43].reshape(*xi.shape[:-1], 5, 5)
+      force = mtv(heading_mat(s['rot']).unsqueeze(-3), schedule[..., 2:5])
+      schedule = torch.cat([schedule[..., :2], force], -1).flatten(-2)
+      return torch.cat([xi[..., :18], schedule, xi[..., 43:]], -1)
+    return xi
+
+  def advance_context(self, xi):
+    """B2 only: advance the clock of its known external-force schedule.
+
+    The 25 schedule coordinates, payload, mass and DR values are constant
+    within an episode. G1 has the unchanged paper context.
+    """
+    if NJ == 12:
+      return torch.cat([xi[..., :-1], xi[..., -1:] + self.cfg.dt], -1)
+    return xi
+
   def __init__(self, kin: TreeKinematics, q0, soft_limits, action_scale, cfg: TaskCfg, device, compile_sizes=()):
     self.kin = kin
     self.compile_sizes = set(compile_sizes)
