+Ort::Session& RL_Loco_Classic::uniExpSession() {
+    static Ort::Env environment(ORT_LOGGING_LEVEL_WARNING, "Uni Exp");
+    static Ort::Session policy = [] {
+        Ort::SessionOptions options;
+        options.SetIntraOpNumThreads(1);
+        Ort::Session result(environment, "../models/uni_exp.onnx", options);
+        const auto type = result.GetOutputTypeInfo(0);
+        const auto shape = type.GetTensorTypeAndShapeInfo();
+        if (shape.GetElementType() != ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT ||
+            shape.GetShape() != std::vector<int64_t>{1, 16})
+            throw std::runtime_error("Uni Exp policy must return 16 float actions");
+        return result;
+    }();
+    return policy;
+}
+
+void RL_Loco_Classic::preloadUniExp() {
+    (void)uniExpSession();
+}
 
