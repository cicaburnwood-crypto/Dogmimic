+bool StandUpController::isSettled(const HardwareState& state) {
+    constexpr double min_imu_upright = .984807753; // cos(10 degrees)
+    constexpr float max_position_error = .23F;
+    constexpr float max_joint_speed = .45F;
+    const double upright = state.imu_estimate.r_b_(2, 2);
+    if (!state.imu_valid || !state.imu_estimate.valid ||
+        !std::isfinite(upright) || upright < min_imu_upright) return false;
+
+    for (std::size_t leg = 0; leg < 4; ++leg) {
+        const auto target = ControllerConfig::standPose(leg);
+        for (std::size_t axis = 0; axis < 4; ++axis) {
+            const auto& joint = state.joints[leg * 4 + axis];
+            if (!joint.valid || !std::isfinite(joint.velocity_rad_s) ||
+                std::abs(joint.velocity_rad_s) > max_joint_speed) return false;
+            if (axis < target.size() &&
+                (!std::isfinite(joint.position_rad) ||
+                 std::abs(joint.position_rad - target[axis]) > max_position_error)) return false;
+        }
+    }
+    return true;
+}
 
