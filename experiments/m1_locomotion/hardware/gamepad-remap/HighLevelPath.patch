 namespace {
+std::array<float, 3> remapUniExpGamepad(const std::array<float, 3>& axes) noexcept {
+    const auto bounded = [](float axis) {
+        return std::isfinite(axis) ? std::clamp(static_cast<double>(axis), -1., 1.) : 0.;
+    };
+    const double forward = bounded(axes[0]);
+    const double lateral = bounded(axes[1]);
+    const double yaw = bounded(axes[2]);
+    // The convex limit also bounds the command after the controller's low-pass filter.
+    const double budget = std::max(1., std::abs(forward) + std::abs(lateral) + std::abs(yaw));
+    // ClassicController still applies the 1.4 m/s, 0.5 m/s and 0.8 rad/s axis gains.
+    return {static_cast<float>(forward / budget),
+            static_cast<float>(lateral * (0.22 / 0.5) / budget),
+            static_cast<float>(yaw * (0.35 / 0.8) / budget)};
+}
