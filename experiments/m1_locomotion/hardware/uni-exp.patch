+void blendStandCommand(const JointCmd& stand, JointCmd& output, float blend) {
+    const float stand_weight = 1.0F - blend;
+    for (std::size_t chip = 0; chip < std::size(output.chip_cmds); ++chip) {
+        for (std::size_t motor = 0; motor < std::size(output.chip_cmds[chip].motor_cmds); ++motor) {
+            const auto& from = stand.chip_cmds[chip].motor_cmds[motor];
+            auto& to = output.chip_cmds[chip].motor_cmds[motor];
+            const float stand_kp = stand_weight * from.kp;
+            const float stand_kd = stand_weight * from.kd;
+            const float policy_kp = blend * to.kp;
+            const float policy_kd = blend * to.kd;
+            to.kp = stand_kp + policy_kp;
+            to.kd = stand_kd + policy_kd;
+            // Weight the targets by their gains to interpolate joint PD effort.
+            if (to.kp > 0.0F)
+                to.q_des = (stand_kp * from.q_des + policy_kp * to.q_des) / to.kp;
+            if (to.kd > 0.0F)
+                to.qd_des = (stand_kd * from.qd_des + policy_kd * to.qd_des) / to.kd;
+            to.tau_ff = stand_weight * from.tau_ff + blend * to.tau_ff;
+        }
+    }
+}
