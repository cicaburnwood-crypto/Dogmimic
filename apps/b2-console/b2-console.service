[Unit]
Description=B2 robot control console (loopback, SSH access)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/unitree/supermimic_b2/console/current
ExecStart=/usr/bin/python3 /home/unitree/supermimic_b2/console/current/server.py --backend sdk --interface eth0 --port 8765 --bundle /home/unitree/supermimic_b2/current --log-dir /home/unitree/supermimic_b2/logs/console
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
